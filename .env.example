# =====================================================================
# 复制本文件为 .env 后再填入真实的 Key
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
# .env 已被 .gitignore 忽略，不会上传到 GitHub。
# =====================================================================

# ---------- 大模型（必填，用于结构化提取）----------
# DeepSeek 平台申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=Your Key

# 若使用其他 OpenAI 兼容服务（如智谱、Moonshot、通义），改这三项即可
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- 大模型调用策略（选填）----------
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_SLEEP_BETWEEN_CALLS=0.5

# ---------- arXiv API（选填，一般无需修改）----------
ARXIV_API_URL=https://export.arxiv.org/api/query
# arXiv 官方建议请求间隔 >= 3 秒，调小容易被封 IP
ARXIV_MIN_INTERVAL=3.0
ARXIV_MAX_RETRIES=3
HTTP_TIMEOUT=30
